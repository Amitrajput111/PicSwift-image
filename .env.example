# ==============================================================================
# PICSWIFT - SAAS PRODUCTION CONFIGURATION TEMPLATE
# ==============================================================================

# Environment setting (production / development)
NODE_ENV=production

# Server deployment port
PORT=5000

# JSON Web Token Secret signature key (Must be a long random string in production)
JWT_SECRET=your_production_secret_session_token_key_here

# MongoDB Connection String (Required for persistent databases in cloud hosts)
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/picswift
# Leave blank to fall back to portable secure local file-based database
MONGODB_URI=

# Optional: Google OAuth Client Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
